# Browser-safe Supabase configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Public Cloudflare Turnstile site key used by the registration form.
# The matching secret key belongs in Supabase Auth CAPTCHA settings, never here.
VITE_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY

# Optional UI ceiling. The database also enforces the account's remaining quota.
# Administrators can upload one file up to the 10 GB shared-pool ceiling.
# Non-admin accounts remain limited to their 200 MB account quota.
VITE_MAX_FILE_SIZE_BYTES=10000000000

# Server-only Netlify variables. Never prefix these with VITE_.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
#
# R2_ACCOUNT_ID=40c2930d265796bcdd131c24aed986d0
# R2_BUCKET_NAME=xiaopan
# R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
# R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
