# Browser-safe Supabase configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# UI display/preflight limits only. R2 multipart objects can be up to 5 TiB.
VITE_STORAGE_QUOTA_BYTES=1099511627776
VITE_MAX_FILE_SIZE_BYTES=5497558138880

# Server-only Netlify variables. Never prefix these with VITE_.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# SUPABASE_SECRET_KEY=sb_secret_YOUR_SECRET_KEY
#
# R2_ACCOUNT_ID=40c2930d265796bcdd131c24aed986d0
# R2_BUCKET_NAME=xiaopan
# R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
# R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
